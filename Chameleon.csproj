<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Rhino 8 Windows/Mac (.NET 7) and Rhino 8 running on .NET Framework -->
    <TargetFrameworks>net7.0;net48</TargetFrameworks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>
    <NoWarn>NU1701</NoWarn>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Chameleon</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.0</Version>
    <Title>Chameleon</Title>
    <Company>Chameleon Authors</Company>
    <Description>Make2D with solid fills for every visible surface, on layers that mirror the source layers - ready to restyle in Illustrator.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="EmbeddedResources\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RhinoCommon" Version="8.0.23304.9001" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
